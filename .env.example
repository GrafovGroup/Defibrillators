# Static Astro site: the public Formspree action is in src/lib/rfq.ts.
# No mail API keys or server secrets are needed for this hosted endpoint.
# Recipient, spam protection and server validations are configured in Formspree.
# Never expose private provider credentials with a PUBLIC_ prefix.

# Production defaults to the owner-authorized indexable launch in src/data/search-launch.ts.
# Use false for a private/staging build only.
# This build-time switch controls page robots metadata and generated robots.txt together.
PUBLIC_SITE_INDEXABLE=false

# Optional public verification tokens only, never passwords or API credentials.
# Production defaults are committed public ownership tags. Override only when changing owners.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
