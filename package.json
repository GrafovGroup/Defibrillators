{
  "name": "defibrillators-ca",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/hosting-headers.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "qa:preview": "node scripts/qa-preview.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm check && pnpm format:check && pnpm build && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "axe-core": "4.14.0",
    "cheerio": "1.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "opentype.js": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
