---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { searchConfig } from '../lib/site-config';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={searchConfig.robots} />
    {searchConfig.google && (
      <meta name="google-site-verification" content={searchConfig.google} />
    )}
    {searchConfig.bing && (
      <meta name="msvalidate.01" content={searchConfig.bing} />
    )}
    <meta
      name="description"
      content="Choose English or French to explore AED equipment and support across Canada. Choisissez le français ou l’anglais pour explorer les solutions de DEA au Canada."
    />
    <title>Defibrillators.ca — Choose your language / Choisir votre langue</title>
    <link rel="canonical" href="https://defibrillators.ca/" />
    <link
      rel="alternate"
      hreflang="en-CA"
      href="https://defibrillators.ca/en/"
    />
    <link
      rel="alternate"
      hreflang="fr-CA"
      href="https://defibrillators.ca/fr/"
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://defibrillators.ca/"
    />
    <link rel="icon" href="/brand/favicon.svg" />
  </head>
  <body class="entry">
    <main>
      <img
        src="/brand/wordmark-light.svg"
        width="440"
        height="70"
        alt="Defibrillators.ca"
      />
      <h1>
        AED solutions across Canada.
        <br />
        <span lang="fr-CA">Solutions de DEA partout au Canada.</span>
      </h1>
      <nav aria-label="Language / Langue" class="actions">
        <a class="button button-navy" href="/en/" lang="en-CA">
          English
        </a>
        <a class="button" href="/fr/" lang="fr-CA">
          Français
        </a>
      </nav>
    </main>
  </body>
</html>
