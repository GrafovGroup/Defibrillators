---
import Page from '../../layouts/Page.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageCard from '../../components/PageCard.astro';
import Catalogue from '../../components/Catalogue.astro';
import PartsFinder from '../../components/PartsFinder.astro';
import PackagePlanner from '../../components/PackagePlanner.astro';
import Comparison from '../../components/Comparison.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CityPage from '../../components/CityPage.astro';
import { enquiryPath } from '../../lib/enquiry';
import EnquiryActions from '../../components/EnquiryActions.astro';
import { pages, pageImages, type DetailPage } from '../../data/pages';
import { products } from '../../data/products';
import { pathFor, labelFor, routes } from '../../data/routes';
import type { Locale } from '../../data/content';
export function getStaticPaths() {
  return pages.flatMap((page) =>
    (['en', 'fr'] as const).map((lang) => ({
      params: { lang, slug: routes[page.id][lang][0] },
      props: { page, lang },
    })),
  );
}
interface Props {
  page: DetailPage;
  lang: Locale;
}
const { page, lang } = Astro.props;
const product = products.find((p) => p.id === page.id);
const sections = page.sections[lang];
const category =
  page.kind === 'product'
    ? lang === 'en'
      ? 'MANUFACTURER REFERENCE'
      : 'FICHE DE RÉFÉRENCE'
    : page.parent
      ? labelFor(page.parent, lang)
      : lang === 'en'
        ? 'AED EQUIPMENT & SUPPORT'
        : 'ÉQUIPEMENT ET ACCOMPAGNEMENT EN DEA';
const isLegal = ['privacy', 'terms', 'accessibility'].includes(page.id);
---

<Page lang={lang} pageId={page.id}>
  <Header lang={lang} pageId={page.id} />
  <main id="main" tabindex="-1">
    <Breadcrumbs lang={lang} pageId={page.id} />
    <section
      class:list={[
        'page-hero',
        {
          'has-image': !!page.image || !!page.location,
          'location-hero': !!page.location,
        },
      ]}
    >
      <div class="container page-hero-grid">
        <div class="page-hero-copy">
          <p class="eyebrow">{category}</p>
          <h1>{labelFor(page.id, lang)}</h1>
          <p>{page.intro[lang]}</p>
          {!isLegal && page.id !== 'quote' && (
            <a class="button" href={enquiryPath(page.id, lang)}>
              {lang === 'en' ? 'Request a quote' : 'Demander une soumission'}
            </a>
          )}
        </div>
        {page.location ? (
          <figure class="location-map">
            <img
              src={`/maps/${page.id}.svg`}
              width="800"
              height="500"
              alt={
                lang === 'en'
                  ? `Geographic locator for ${page.location.place.en} within Canada`
                  : `Repère géographique : ${page.location.place.fr} au Canada`
              }
              fetchpriority="high"
            />
            <figcaption>
              {lang === 'en'
                ? 'Geographic locator · not a service coverage map'
                : 'Repère géographique · ne représente pas la desserte'}
            </figcaption>
          </figure>
        ) : (
          page.image && (
            <figure>
              <img
                src={`/images/${page.image}.webp`}
                width="800"
                height="600"
                alt={pageImages[page.image][lang]}
                fetchpriority="high"
              />
              <figcaption>
                {lang === 'en'
                  ? 'Illustrative photograph · equipment and configuration to be confirmed'
                  : 'Photo à titre indicatif · équipement et configuration à confirmer'}
              </figcaption>
            </figure>
          )
        )}
      </div>
    </section>
    <div class="container page-body">
      {page.location && (
        <p class="map-credit">
          {lang === 'en'
            ? 'Adapted from Statistics Canada, Canada provincial and territorial boundaries (2023), via '
            : 'Adapté de Statistique Canada, limites des provinces et territoires du Canada (2023), par '}
          <a href="https://www.geoboundaries.org/api/current/gbOpen/CAN/ADM1/">
            geoBoundaries
          </a>
          .{' '}
          <a href="https://www.statcan.gc.ca/en/terms-conditions/open-licence">
            {lang === 'en' ? 'Open licence' : 'Licence ouverte'}
          </a>
          .{' '}
          {lang === 'en'
            ? 'This does not constitute an endorsement by Statistics Canada of this product. Generalized for orientation; not an official map.'
            : 'Cela ne constitue pas une approbation de ce produit par Statistique Canada. Carte généralisée à titre de repère, non officielle.'}
        </p>
      )}
      {page.kind === 'parts' && <PartsFinder lang={lang} />}
      {page.kind === 'packages' && <PackagePlanner lang={lang} />}
      {page.kind === 'catalogue' && <Catalogue lang={lang} />}
      {page.kind === 'comparison' && <Comparison lang={lang} />}
      {product && (
        <section class="product-status" aria-labelledby="model-status">
          <h2 id="model-status">
            {lang === 'en'
              ? 'Product information status'
              : 'État des renseignements sur le produit'}
          </h2>
          <dl>
            <div>
              <dt>
                {lang === 'en' ? 'Canadian licence' : 'Homologation canadienne'}
              </dt>
              <dd>
                {lang === 'en'
                  ? 'Not yet verified for the exact device'
                  : 'Pas encore vérifiée pour l’appareil exact'}
              </dd>
            </div>
            <div>
              <dt>
                {lang === 'en'
                  ? 'Availability & price'
                  : 'Disponibilité et prix'}
              </dt>
              <dd>
                {lang === 'en'
                  ? 'Unconfirmed · written quote required'
                  : 'Non confirmés · soumission écrite requise'}
              </dd>
            </div>
            <div>
              <dt>
                {lang === 'en'
                  ? 'Included items & warranty'
                  : 'Articles inclus et garantie'}
              </dt>
              <dd>
                {lang === 'en'
                  ? 'To be confirmed for the supplied configuration'
                  : 'À confirmer pour la configuration fournie'}
              </dd>
            </div>
          </dl>
          <p>
            {lang === 'en' ? 'Source:' : 'Source :'}{' '}
            <a href={product.source.url}>{product.source.label}</a> ·{' '}
            {lang === 'en' ? 'Reviewed' : 'Consultée le'}{' '}
            {product.source.reviewed}.{' '}
            {lang === 'en'
              ? 'Manufacturer information is not Canadian licence verification.'
              : 'Les renseignements du fabricant ne constituent pas une vérification de l’homologation canadienne.'}
          </p>
          <a
            class="text-link"
            href="https://health-products.canada.ca/mdall-limh/index-eng.jsp"
          >
            {lang === 'en'
              ? 'Health Canada MDALL'
              : 'Base de données MDALL de Santé Canada'}
          </a>
        </section>
      )}
      {page.children && (
        <section
          class="page-directory"
          aria-label={
            lang === 'en' ? 'Explore this section' : 'Explorer cette section'
          }
        >
          <div class="page-card-grid">
            {page.children.map((id) => (
              <PageCard lang={lang} pageId={id} />
            ))}
          </div>
        </section>
      )}
      <div class:list={['article-layout', { 'article-full': isLegal }]}>
        <article class="article-copy">
          {page.guide && (
            <>
              <p class="guide-byline">
                {lang === 'en' ? 'Prepared by' : 'Préparé par'}{' '}
                <a href={pathFor('about', lang)}>Defibrillators.ca</a> ·{' '}
                {lang === 'en' ? 'Updated' : 'Mis à jour le'}{' '}
                <time datetime={page.guide.reviewed}>
                  {page.guide.reviewed}
                </time>
              </p>
              <section
                class="guide-answer"
                aria-labelledby="guide-answer-heading"
              >
                <h2 id="guide-answer-heading">
                  {lang === 'en' ? 'The key points' : 'Les points essentiels'}
                </h2>
                <p>{page.guide.summary[lang]}</p>
              </section>
              <nav
                class="guide-toc"
                aria-label={lang === 'en' ? 'On this page' : 'Sur cette page'}
              >
                <strong>
                  {lang === 'en' ? 'On this page' : 'Sur cette page'}
                </strong>
                <ol>
                  {sections.map((section, index) => (
                    <li>
                      <a href={`#section-${index + 1}`}>{section.heading}</a>
                    </li>
                  ))}
                  <li>
                    <a href="#guide-questions">
                      {lang === 'en'
                        ? 'Common questions'
                        : 'Questions courantes'}
                    </a>
                  </li>
                  <li>
                    <a href="#guide-sources">
                      {lang === 'en'
                        ? 'Reference sources'
                        : 'Sources de référence'}
                    </a>
                  </li>
                </ol>
              </nav>
            </>
          )}
          {page.kind === 'quote' && <QuoteForm lang={lang} />}
          {page.kind === 'location' ? (
            <CityPage page={page} lang={lang} />
          ) : page.kind === 'faq' ? (
            <div class="faq-list">
              {sections.map((section) => (
                <details>
                  <summary>{section.heading}</summary>
                  <p>{section.body}</p>
                </details>
              ))}
            </div>
          ) : (
            sections.map((section, index) => (
              <section id={`section-${index + 1}`}>
                <h2>{section.heading}</h2>
                <p>{section.body}</p>
                {section.bullets && (
                  <ul>
                    {section.bullets.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          )}
          {page.guide && (
            <>
              <section id="guide-questions" class="faq-list">
                <h2>
                  {lang === 'en' ? 'Common questions' : 'Questions courantes'}
                </h2>
                {page.guide.faqs[lang].map((faq) => (
                  <details>
                    <summary>{faq.heading}</summary>
                    <p>{faq.body}</p>
                  </details>
                ))}
              </section>
              <section id="guide-sources" class="guide-sources">
                <h2>
                  {lang === 'en' ? 'Reference sources' : 'Sources de référence'}
                </h2>
                <p>
                  {lang === 'en'
                    ? 'Manufacturer references explain model-specific differences. They do not establish our prices, inventory or Canadian licensing. This guide supports procurement planning; use the current instructions for your exact device.'
                    : 'Les références des fabricants expliquent les différences entre modèles. Elles ne confirment ni nos prix, ni notre inventaire, ni l’homologation canadienne. Ce guide aide à planifier l’achat; utilisez les instructions actuelles de votre appareil exact.'}
                </p>
                <ul>
                  {page.guide.sources.map((source) => (
                    <li>
                      <a href={source.url}>{source.label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            </>
          )}
        </article>
        {!isLegal && (
          <aside
            class="page-sidebar"
            aria-label={
              lang === 'en'
                ? 'Enquiry information'
                : 'Renseignements pour une demande'
            }
          >
            <EnquiryActions
              lang={lang}
              quote={page.kind === 'quote'}
              pageId={page.id}
              subject={`${lang === 'en' ? 'Enquiry' : 'Demande'} — ${labelFor(page.id, lang)}`}
            />
            <p class="sidebar-note">
              {lang === 'en'
                ? 'Equipment and service arrangements are confirmed for your location before any commitment.'
                : 'L’équipement et les modalités de service sont confirmés pour votre emplacement avant tout engagement.'}
            </p>
          </aside>
        )}
      </div>
      {page.related && (
        <nav
          class="related-pages"
          aria-label={
            lang === 'en' ? 'Related information' : 'Renseignements connexes'
          }
        >
          <h2>
            {lang === 'en'
              ? 'Continue planning'
              : 'Poursuivre votre planification'}
          </h2>
          <ul>
            {page.related.map((id) => (
              <li>
                <a href={pathFor(id, lang)}>{labelFor(id, lang)}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </main>
  <Footer lang={lang} />
</Page>
