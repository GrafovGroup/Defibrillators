---
import ProcurementChecklist from '../../components/ProcurementChecklist.astro';
import Page from '../../layouts/Page.astro';
import SiteSearch from '../../components/SiteSearch.astro';
import OwnershipBudget from '../../components/OwnershipBudget.astro';
import BusinessDetails from '../../components/BusinessDetails.astro';
import ProductFacts from '../../components/ProductFacts.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageCard from '../../components/PageCard.astro';
import Catalogue from '../../components/Catalogue.astro';
import PartsFinder from '../../components/PartsFinder.astro';
import PackagePlanner from '../../components/PackagePlanner.astro';
import Comparison from '../../components/Comparison.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CityPage from '../../components/CityPage.astro';
import LocationFinder from '../../components/LocationFinder.astro';
import OfferingDirectory from '../../components/OfferingDirectory.astro';
import CityContext from '../../components/CityContext.astro';
import { cityCatalogue, type CityId } from '../../data/city-catalogue';
import { offeringIds, type OfferingId } from '../../data/offering-routes';
import { enquiryPath } from '../../lib/enquiry';
import EnquiryActions from '../../components/EnquiryActions.astro';
import { pages, type DetailPage } from '../../data/pages';
import PageVisual from '../../components/PageVisual.astro';
import { visuals, visualCaption } from '../../data/visuals';
import { products } from '../../data/products';
import { pathFor, labelFor, routes } from '../../data/routes';
import type { Locale } from '../../data/content';
export function getStaticPaths() {
  return pages.flatMap((page) =>
    (['en', 'fr'] as const).map((lang) => ({
      params: { lang, slug: routes[page.id][lang][0] },
      props: { page, lang },
    })),
  );
}
interface Props {
  page: DetailPage;
  lang: Locale;
}
const { page, lang } = Astro.props;
const product = products.find((p) => p.id === page.id);
const sections = page.sections[lang];
const category =
  page.kind === 'product'
    ? lang === 'en'
      ? 'AED MODEL'
      : 'MODÈLE DE DEA'
    : page.parent
      ? labelFor(page.parent, lang)
      : lang === 'en'
        ? 'AED EQUIPMENT & SUPPORT'
        : 'ÉQUIPEMENT ET ACCOMPAGNEMENT EN DEA';
const isOffering = offeringIds.includes(page.id as OfferingId);
const isCity = Object.hasOwn(cityCatalogue, page.id);
const isRegion = page.location && page.parent === 'locations';
const isLegal = ['privacy', 'terms', 'accessibility'].includes(page.id);
---

<Page lang={lang} pageId={page.id}>
  <Header lang={lang} pageId={page.id} />
  <main id="main" tabindex="-1">
    <Breadcrumbs lang={lang} pageId={page.id} />
    <section
      class:list={[
        'page-hero',
        {
          'has-image': !!page.image || !!page.location,
          'location-hero': !!page.location,
        },
      ]}
    >
      <div class="container page-hero-grid">
        <div class="page-hero-copy">
          <p class="eyebrow">{category}</p>
          <h1>{labelFor(page.id, lang)}</h1>
          <p>{page.intro[lang]}</p>
          {(page.id === 'locations' || isRegion) && (
            <p>
              <a class="text-link" href="#city-directory-heading">
                {lang === 'en'
                  ? 'Find your city in the directory ↓'
                  : 'Trouvez votre ville dans le répertoire ↓'}
              </a>
            </p>
          )}
          {!isLegal && !['quote', 'search'].includes(page.id) && (
            <a class="button" href={enquiryPath(page.id, lang)}>
              {lang === 'en' ? 'Request a quote' : 'Demander une soumission'}
            </a>
          )}
        </div>
        {page.location ? (
          <figure class="location-map">
            <img
              src={`/maps/${page.location.mapId}.svg`}
              width="800"
              height="500"
              alt={
                lang === 'en'
                  ? page.location.mapId !== page.id
                    ? `Province or territory locator for the ${page.location.place.en} guide`
                    : `Geographic locator for ${page.location.place.en} within Canada`
                  : page.location.mapId !== page.id
                    ? `Repère provincial ou territorial pour le guide de ${page.location.place.fr}`
                    : `Repère géographique : ${page.location.place.fr} au Canada`
              }
              fetchpriority="high"
            />
            <figcaption>
              {lang === 'en'
                ? page.location.mapId !== page.id
                  ? 'Province / territory locator'
                  : 'Geographic locator'
                : page.location.mapId !== page.id
                  ? 'Repère provincial / territorial'
                  : 'Repère géographique'}
            </figcaption>
          </figure>
        ) : (
          page.image && (
            <figure class="page-visual">
              <PageVisual image={page.image} lang={lang} priority />
              <figcaption>
                {visualCaption(visuals[page.image], lang)}
              </figcaption>
            </figure>
          )
        )}
      </div>
    </section>
    <div class="container page-body">
      {page.location && (
        <p class="map-credit">
          {lang === 'en'
            ? 'Adapted from Statistics Canada, Canada provincial and territorial boundaries (2023), via '
            : 'Adapté de Statistique Canada, limites des provinces et territoires du Canada (2023), par '}
          <a href="https://www.geoboundaries.org/api/current/gbOpen/CAN/ADM1/">
            geoBoundaries
          </a>
          .{' '}
          <a href="https://www.statcan.gc.ca/en/terms-conditions/open-licence">
            {lang === 'en' ? 'Open licence' : 'Licence ouverte'}
          </a>
          .{' '}
          {lang === 'en'
            ? 'This does not constitute an endorsement by Statistics Canada of this product. Generalized for orientation; not an official map.'
            : 'Cela ne constitue pas une approbation de ce produit par Statistique Canada. Carte généralisée à titre de repère, non officielle.'}
        </p>
      )}
      {isOffering && <CityContext lang={lang} pageId={page.id} />}
      {(page.id === 'locations' || isRegion) && (
        <LocationFinder lang={lang} region={isRegion ? page.id : undefined} />
      )}
      {page.kind === 'parts' && <PartsFinder lang={lang} />}
      {page.kind === 'packages' && <PackagePlanner lang={lang} />}
      {page.kind === 'catalogue' && <Catalogue lang={lang} />}
      {page.kind === 'comparison' && <Comparison lang={lang} />}
      {product && <ProductFacts lang={lang} product={product} />}
      {page.id === 'search' && <SiteSearch lang={lang} />}
      {page.children && !isRegion && (
        <section
          class="page-directory"
          aria-label={
            lang === 'en' ? 'Explore this section' : 'Explorer cette section'
          }
        >
          <div class="page-card-grid">
            {page.children.map((id) => (
              <PageCard
                lang={lang}
                pageId={id}
                compact={page.id === 'locations'}
              />
            ))}
          </div>
        </section>
      )}
      <div
        class:list={[
          'article-layout',
          { 'article-full': isLegal || page.id === 'search' },
        ]}
      >
        <article class="article-copy">
          {page.guide && (
            <>
              <p class="guide-byline">
                {lang === 'en' ? 'Prepared by' : 'Préparé par'}{' '}
                <a href={pathFor('about', lang)}>Defibrillators.ca</a> ·{' '}
                {lang === 'en' ? 'Updated' : 'Mis à jour le'}{' '}
                <time datetime={page.guide.reviewed}>
                  {page.guide.reviewed}
                </time>
              </p>
              <section
                class="guide-answer"
                aria-labelledby="guide-answer-heading"
              >
                <h2 id="guide-answer-heading">
                  {lang === 'en' ? 'The key points' : 'Les points essentiels'}
                </h2>
                <p>{page.guide.summary[lang]}</p>
              </section>
              <nav
                class="guide-toc"
                aria-label={lang === 'en' ? 'On this page' : 'Sur cette page'}
              >
                <strong>
                  {lang === 'en' ? 'On this page' : 'Sur cette page'}
                </strong>
                <ol>
                  {sections.map((section, index) => (
                    <li>
                      <a href={`#section-${index + 1}`}>{section.heading}</a>
                    </li>
                  ))}
                  <li>
                    <a href="#guide-questions">
                      {lang === 'en'
                        ? 'Common questions'
                        : 'Questions courantes'}
                    </a>
                  </li>
                  <li>
                    <a href="#guide-sources">
                      {lang === 'en'
                        ? 'Reference sources'
                        : 'Sources de référence'}
                    </a>
                  </li>
                </ol>
              </nav>
            </>
          )}
          {['about', 'contact', 'privacy', 'terms'].includes(page.id) && (
            <BusinessDetails lang={lang} />
          )}
          {page.id === 'buying' && <ProcurementChecklist lang={lang} />}
          {page.id === 'costs' && <OwnershipBudget lang={lang} />}
          {page.kind === 'quote' && <QuoteForm lang={lang} />}
          {page.kind === 'location' ? (
            <CityPage page={page} lang={lang} />
          ) : page.kind === 'faq' ? (
            <div class="faq-list">
              {sections.map((section) => (
                <details>
                  <summary>{section.heading}</summary>
                  <p>{section.body}</p>
                </details>
              ))}
            </div>
          ) : (
            sections.map((section, index) => (
              <section id={`section-${index + 1}`}>
                <h2>{section.heading}</h2>
                <p>{section.body}</p>
                {section.bullets && (
                  <ul>
                    {section.bullets.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          )}
          {page.id === 'procurement' && <BusinessDetails lang={lang} />}
          {page.guide && (
            <>
              <section id="guide-questions" class="faq-list">
                <h2>
                  {lang === 'en' ? 'Common questions' : 'Questions courantes'}
                </h2>
                {page.guide.faqs[lang].map((faq) => (
                  <details>
                    <summary>{faq.heading}</summary>
                    <p>{faq.body}</p>
                  </details>
                ))}
              </section>
              <section id="guide-sources" class="guide-sources">
                <h2>
                  {lang === 'en' ? 'Reference sources' : 'Sources de référence'}
                </h2>
                <p>
                  {lang === 'en'
                    ? 'Use these manufacturer resources to check model details. For operation and maintenance, follow the current instructions supplied with your device.'
                    : 'Consultez ces ressources des fabricants pour les détails des modèles. Pour l’utilisation et l’entretien, suivez les instructions actuelles fournies avec votre appareil.'}
                </p>
                <ul>
                  {page.guide.sources.map((source) => (
                    <li>
                      <a href={source.url}>{source.label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            </>
          )}
        </article>
        {!isLegal && page.id !== 'search' && (
          <aside
            class="page-sidebar"
            aria-label={
              lang === 'en'
                ? 'Enquiry information'
                : 'Renseignements pour une demande'
            }
          >
            <EnquiryActions
              lang={lang}
              quote={page.kind === 'quote'}
              pageId={page.id}
              subject={`${lang === 'en' ? 'Enquiry' : 'Demande'} — ${labelFor(page.id, lang)}`}
            />
            <p class="sidebar-note">
              {lang === 'en'
                ? 'Equipment and service arrangements are confirmed for your location before any commitment.'
                : 'L’équipement et les modalités de service sont confirmés pour votre emplacement avant tout engagement.'}
            </p>
          </aside>
        )}
      </div>
      {(isCity || page.id === 'services' || page.id === 'accessories') && (
        <OfferingDirectory
          lang={lang}
          city={isCity ? (page.id as CityId) : undefined}
          group={
            page.id === 'services'
              ? 'services'
              : page.id === 'accessories'
                ? 'accessories'
                : undefined
          }
        />
      )}
      {page.related && (
        <nav
          class="related-pages"
          aria-label={
            lang === 'en' ? 'Related information' : 'Renseignements connexes'
          }
        >
          <h2>
            {lang === 'en'
              ? 'Explore related topics'
              : 'Voir les sujets connexes'}
          </h2>
          <ul>
            {page.related.map((id) => (
              <li>
                <a href={pathFor(id, lang)}>{labelFor(id, lang)}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </main>
  <Footer lang={lang} />
</Page>
