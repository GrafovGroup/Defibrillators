---
import { products } from '../data/products';
import { pathFor, labelFor } from '../data/routes';
import type { Locale } from '../data/content';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const rows = [
  {
    label: lang === 'en' ? 'Manufacturer' : 'Fabricant',
    values: products.map((p) => p.manufacturer),
  },
  {
    label: lang === 'en' ? 'Guidance' : 'Guidage',
    values: products.map((p) => p.guidance[lang]),
  },
  {
    label: lang === 'en' ? 'Electrode approach' : 'Électrodes',
    values: products.map((p) => p.electrodes[lang]),
  },
  {
    label:
      lang === 'en'
        ? 'Canadian licence verification'
        : 'Vérification de l’homologation canadienne',
    values: products.map(() =>
      lang === 'en'
        ? 'Unverified — confirm the exact device before sale'
        : 'Non vérifiée — confirmer l’appareil exact avant la vente',
    ),
  },
  {
    label:
      lang === 'en' ? 'Price, stock & warranty' : 'Prix, stock et garantie',
    values: products.map(() =>
      lang === 'en'
        ? 'Not confirmed; request written details'
        : 'Non confirmés; demander les modalités écrites',
    ),
  },
];
---

<fieldset class="comparison-controls" hidden data-comparison-controls>
  <legend>
    {lang === 'en'
      ? 'Choose two different models to compare'
      : 'Choisir deux modèles différents à comparer'}
  </legend>
  {[0, 1].map((index) => (
    <div>
      <label for={`compare-${index}`}>
        {lang === 'en' ? `Model ${index + 1}` : `Modèle ${index + 1}`}
      </label>
      <select id={`compare-${index}`} data-compare-select>
        {products.map((p, i) => (
          <option value={p.id} selected={i === index}>
            {labelFor(p.id, lang)}
          </option>
        ))}
      </select>
    </div>
  ))}
</fieldset>
<p data-comparison-status role="status" aria-live="polite"></p>
<div
  class="comparison-scroll"
  role="region"
  aria-label={
    lang === 'en'
      ? 'AED comparison table; scroll horizontally on a small screen'
      : 'Tableau comparatif; défilement horizontal sur petit écran'
  }
  tabindex="0"
>
  <table class="comparison-table">
    <caption>
      {lang === 'en'
        ? 'Manufacturer reference comparison'
        : 'Comparaison des renseignements des fabricants'}
    </caption>
    <thead>
      <tr>
        <th scope="col">
          {lang === 'en' ? 'Consideration' : 'Point à considérer'}
        </th>
        {products.map((p) => (
          <th scope="col" data-compare-model={p.id}>
            <a href={pathFor(p.id, lang)}>{labelFor(p.id, lang)}</a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {row.values.map((value, index) => (
            <td data-compare-model={products[index].id}>{value}</td>
          ))}
        </tr>
      ))}
      <tr>
        <th scope="row">{lang === 'en' ? 'Source' : 'Source'}</th>
        {products.map((p) => (
          <td data-compare-model={p.id}>
            <a href={p.source.url}>{p.source.label}</a>
          </td>
        ))}
      </tr>
    </tbody>
  </table>
</div>

<script>
  const controls = document.querySelector<HTMLFieldSetElement>(
    '[data-comparison-controls]',
  );
  if (controls) {
    const selects = [
      ...controls.querySelectorAll<HTMLSelectElement>('[data-compare-select]'),
    ];
    const cells = [
      ...document.querySelectorAll<HTMLElement>('[data-compare-model]'),
    ];
    const update = () => {
      const ids = selects.map((s) => s.value);
      for (const cell of cells)
        cell.hidden = !ids.includes(cell.dataset.compareModel!);
      // Keep visible columns in the same order as the two labelled choices.
      for (const row of document.querySelectorAll('.comparison-table tr')) {
        for (const id of ids) {
          const cell = [
            ...row.querySelectorAll<HTMLElement>('[data-compare-model]'),
          ].find((cell) => cell.dataset.compareModel === id);
          if (cell) row.append(cell);
        }
      }
      for (const [index, select] of selects.entries())
        for (const option of select.options)
          option.disabled = option.value === ids[1 - index];
      document.querySelector('[data-comparison-status]')!.textContent = [
        ...new Set(selects.map((s) => s.selectedOptions[0].textContent)),
      ].join(' · ');
    };
    controls.hidden = false;
    for (const select of selects) select.addEventListener('change', update);
    update();
  }
</script>
