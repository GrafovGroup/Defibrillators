---
import { products } from '../data/products';
import { pathFor } from '../data/routes';
import ProductCard from './ProductCard.astro';
import type { Locale } from '../data/content';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<section
  class="catalogue-panel"
  aria-labelledby="catalogue-title"
  data-catalogue
  data-lang={lang}
>
  <div class="catalogue-heading">
    <h2 id="catalogue-title">
      {lang === 'en' ? 'Explore AED models' : 'Explorer les modèles de DEA'}
    </h2>
    <a href={pathFor('compare', lang)}>
      {lang === 'en' ? 'Compare both models' : 'Comparer les deux modèles'}
    </a>
  </div>
  <p class="notice">
    {lang === 'en'
      ? 'Manufacturer reference information. Canadian licence verification and supply availability remain unconfirmed for both profiles. No online orders are accepted.'
      : 'Renseignements de référence des fabricants. L’homologation canadienne et la disponibilité restent à confirmer pour les deux fiches. Aucune commande en ligne n’est acceptée.'}
  </p>
  <div
    class="catalogue-filters"
    role="search"
    aria-label={
      lang === 'en'
        ? 'Filter model references'
        : 'Filtrer les fiches de modèles'
    }
    hidden
  >
    <div>
      <label for="model-search">
        {lang === 'en' ? 'Search models' : 'Rechercher un modèle'}
      </label>
      <input
        id="model-search"
        type="search"
        autocomplete="off"
        placeholder={
          lang === 'en' ? 'Name or feature' : 'Nom ou caractéristique'
        }
      />
    </div>
    <div>
      <label for="brand-filter">
        {lang === 'en' ? 'Manufacturer' : 'Fabricant'}
      </label>
      <select id="brand-filter">
        <option value="">
          {lang === 'en' ? 'All manufacturers' : 'Tous les fabricants'}
        </option>
        {products.map((p) => (
          <option value={p.manufacturer}>{p.manufacturer}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="environment-filter">
        {lang === 'en' ? 'Environment' : 'Environnement'}
      </label>
      <select id="environment-filter">
        <option value="">
          {lang === 'en' ? 'All reference profiles' : 'Toutes les fiches'}
        </option>
        <option value="indoor">
          {lang === 'en'
            ? 'Verified for indoor use'
            : 'Usage intérieur vérifié'}
        </option>
        <option value="outdoor">
          {lang === 'en'
            ? 'Verified for outdoor use'
            : 'Usage extérieur vérifié'}
        </option>
        <option value="unverified">
          {lang === 'en'
            ? 'Site suitability to confirm'
            : 'Emplacement à confirmer'}
        </option>
      </select>
    </div>
    <div>
      <label for="type-filter">
        {lang === 'en' ? 'Product type' : 'Type de produit'}
      </label>
      <select id="type-filter">
        <option value="">
          {lang === 'en' ? 'All types' : 'Tous les types'}
        </option>
        <option value="aed">{lang === 'en' ? 'AED' : 'DEA'}</option>
        <option value="accessory">
          {lang === 'en' ? 'Accessory' : 'Accessoire'}
        </option>
      </select>
    </div>
    <button type="button" class="button button-navy" data-reset>
      {lang === 'en' ? 'Reset' : 'Réinitialiser'}
    </button>
  </div>
  <p
    class="result-count"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-count
  >
    {lang === 'en' ? '2 model references' : '2 fiches de modèles'}
  </p>
  <div class="product-grid">
    {products.map((product) => (
      <ProductCard lang={lang} product={product} />
    ))}
  </div>
  <p class="empty-results" data-empty hidden>
    {lang === 'en'
      ? 'No verified profiles match these filters. Site suitability remains unverified for both models. Ask us about your location or browse the accessory pages.'
      : 'Aucune fiche vérifiée ne correspond. L’emplacement approprié reste à confirmer pour les deux modèles. Décrivez-nous votre lieu ou consultez les pages d’accessoires.'}
  </p>
</section>
<script>
  import { matchesProduct } from '../scripts/catalogue-filter';
  const catalogue = document.querySelector<HTMLElement>('[data-catalogue]');
  if (catalogue) {
    const controls =
      catalogue.querySelector<HTMLElement>('.catalogue-filters')!;
    const search = catalogue.querySelector<HTMLInputElement>('#model-search')!;
    const brand = catalogue.querySelector<HTMLSelectElement>('#brand-filter')!;
    const environment = catalogue.querySelector<HTMLSelectElement>(
      '#environment-filter',
    )!;
    const type = catalogue.querySelector<HTMLSelectElement>('#type-filter')!;
    const cards = Array.from(
      catalogue.querySelectorAll<HTMLElement>('[data-product]'),
    );
    const update = () => {
      let count = 0;
      for (const card of cards) {
        card.hidden = !matchesProduct(
          card.dataset.search ?? '',
          card.dataset.brand ?? '',
          search.value,
          brand.value,
          {
            environments: (card.dataset.environments ?? '').split(','),
            type: card.dataset.type ?? '',
          },
          environment.value,
          type.value,
        );
        if (!card.hidden) count++;
      }
      catalogue.querySelector('[data-count]')!.textContent =
        catalogue.dataset.lang === 'fr'
          ? `${count} fiche${count === 1 ? '' : 's'} de modèle${count === 1 ? '' : 's'}`
          : `${count} model reference${count === 1 ? '' : 's'}`;
      catalogue.querySelector<HTMLElement>('[data-empty]')!.hidden =
        count !== 0;
    };
    controls.hidden = false;
    search.addEventListener('input', update);
    brand.addEventListener('change', update);
    environment.addEventListener('change', update);
    type.addEventListener('change', update);
    catalogue.querySelector('[data-reset]')!.addEventListener('click', () => {
      search.value = '';
      brand.value = '';
      environment.value = '';
      type.value = '';
      update();
      search.focus();
    });
  }
</script>
