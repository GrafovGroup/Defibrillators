---
import { products } from '../data/products';
import { pathFor } from '../data/routes';
import ProductCard from './ProductCard.astro';
import type { Locale } from '../data/content';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const brands = [...new Set(products.map((p) => p.manufacturer))].sort();
---

<section
  class="catalogue-panel"
  aria-labelledby="catalogue-title"
  data-catalogue
  data-lang={lang}
>
  <div class="catalogue-heading">
    <h2 id="catalogue-title">
      {lang === 'en' ? 'Explore AED models' : 'Explorer les modèles de DEA'}
    </h2>
    <a href={pathFor('compare', lang)}>
      {lang === 'en' ? 'Compare models' : 'Comparer les modèles'}
    </a>
  </div>
  <nav
    class="catalogue-paths"
    aria-label={
      lang === 'en' ? 'Equipment planning' : 'Planification d’équipement'
    }
  >
    <a href={pathFor('packages', lang)}>
      {lang === 'en'
        ? 'Plan a complete package'
        : 'Planifier un ensemble complet'}
    </a>
    <a href={pathFor('parts', lang)}>
      {lang === 'en'
        ? 'Find replacement parts'
        : 'Trouver des pièces de remplacement'}
    </a>
    <a href={pathFor('costs', lang)}>
      {lang === 'en'
        ? 'Plan your ownership budget'
        : 'Prévoir le budget de suivi'}
    </a>
  </nav>
  <p class="notice">
    {lang === 'en'
      ? 'Manufacturer reference profiles. Exact Canadian licensing, site suitability, configuration and availability must be confirmed before a sale. No online orders are accepted.'
      : 'Fiches de référence des fabricants. L’homologation canadienne, le lieu approprié, la configuration et la disponibilité doivent être confirmés avant la vente. Aucune commande en ligne n’est acceptée.'}
  </p>
  <div
    class="catalogue-filters"
    role="search"
    aria-label={
      lang === 'en'
        ? 'Filter model references'
        : 'Filtrer les fiches de modèles'
    }
    hidden
  >
    <div>
      <label for="model-search">
        {lang === 'en' ? 'Search models' : 'Rechercher un modèle'}
      </label>
      <input
        id="model-search"
        type="search"
        autocomplete="off"
        placeholder={
          lang === 'en' ? 'Name or feature' : 'Nom ou caractéristique'
        }
      />
    </div>
    <div>
      <label for="brand-filter">
        {lang === 'en' ? 'Manufacturer / brand' : 'Fabricant / marque'}
      </label>
      <select id="brand-filter">
        <option value="">
          {lang === 'en' ? 'All manufacturers' : 'Tous les fabricants'}
        </option>
        {brands.map((brand) => (
          <option value={brand}>{brand}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="guidance-filter">
        {lang === 'en' ? 'Guidance feature' : 'Fonction de guidage'}
      </label>
      <select id="guidance-filter">
        <option value="">
          {lang === 'en' ? 'All guidance types' : 'Tous les guidages'}
        </option>
        <option value="voice">
          {lang === 'en'
            ? 'Voice-led guidance'
            : 'Guidage principalement vocal'}
        </option>
        <option value="feedback">
          {lang === 'en'
            ? 'Compression feedback option'
            : 'Option de rétroaction des compressions'}
        </option>
        <option value="video">
          {lang === 'en' ? 'Video guidance' : 'Guidage vidéo'}
        </option>
      </select>
    </div>
    <button type="button" class="button button-navy" data-reset>
      {lang === 'en' ? 'Reset' : 'Réinitialiser'}
    </button>
  </div>
  <p
    class="result-count"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    data-count
  >
    {products.length} {lang === 'en' ? 'model references' : 'fiches de modèles'}
  </p>
  <div class="product-grid">
    {products.map((product) => (
      <ProductCard lang={lang} product={product} />
    ))}
  </div>
  <p class="empty-results" data-empty hidden>
    {lang === 'en'
      ? 'No model references match. Clear a filter or reset to see all models. For an unlisted model, describe it in your enquiry.'
      : 'Aucune fiche correspondante. Retirez un filtre ou réinitialisez pour voir les modèles. Pour un modèle non présenté, précisez-le dans votre demande.'}
  </p>
</section>
<script>
  import { matchesProduct } from '../scripts/catalogue-filter';
  const catalogue = document.querySelector<HTMLElement>('[data-catalogue]');
  if (catalogue) {
    const controls =
      catalogue.querySelector<HTMLElement>('.catalogue-filters')!;
    const search = catalogue.querySelector<HTMLInputElement>('#model-search')!;
    const brand = catalogue.querySelector<HTMLSelectElement>('#brand-filter')!;
    const guidance =
      catalogue.querySelector<HTMLSelectElement>('#guidance-filter')!;
    const cards = [
      ...catalogue.querySelectorAll<HTMLElement>('[data-product]'),
    ];
    const update = () => {
      let count = 0;
      for (const card of cards) {
        card.hidden =
          !matchesProduct(
            card.dataset.search ?? '',
            card.dataset.brand ?? '',
            search.value,
            brand.value,
          ) ||
          (!!guidance.value && card.dataset.guidance !== guidance.value);
        if (!card.hidden) count++;
      }
      catalogue.querySelector('[data-count]')!.textContent =
        catalogue.dataset.lang === 'fr'
          ? `${count} fiche${count === 1 ? '' : 's'} de modèle${count === 1 ? '' : 's'}`
          : `${count} model reference${count === 1 ? '' : 's'}`;
      catalogue.querySelector<HTMLElement>('[data-empty]')!.hidden =
        count !== 0;
    };
    controls.hidden = false;
    search.addEventListener('input', update);
    brand.addEventListener('change', update);
    guidance.addEventListener('change', update);
    catalogue.querySelector('[data-reset]')!.addEventListener('click', () => {
      search.value = '';
      brand.value = '';
      guidance.value = '';
      update();
      search.focus();
    });
    update();
  }
</script>
