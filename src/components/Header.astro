---
import Logo from './Logo.astro';
import { enquiryPath } from '../lib/enquiry';
import Icon from './Icon.astro';
import LocaleSwitch from './LocaleSwitch.astro';
import { content, contact, type Locale } from '../data/content';
import { pathFor, navIds, type PageId } from '../data/routes';
import { pageFor } from '../data/pages';
interface Props {
  lang: Locale;
  pageId?: PageId;
}
const { lang, pageId = 'home' } = Astro.props;
const parent = pageId === 'home' ? null : pageFor(pageId).parent;
const c = content[lang];
---

<a class="skip-link" href="#main">
  {c.skip}
</a>
<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <LocaleSwitch lang={lang} pageId={pageId} />
      <div class="utility-right">
        <a class="utility-coverage" href={pathFor('locations', lang)}>
          <Icon name="maple" />
          <span>{c.coverage}</span>
        </a>
        <span class="utility-detail">
          <Icon name="tools" />
          {lang === 'en' ? 'Installation & support' : 'Installation et soutien'}
        </span>
        <span class="utility-detail">
          <Icon name="shield" />
          {lang === 'en'
            ? 'Commercial & residential'
            : 'Commercial et résidentiel'}
        </span>
      </div>
    </div>
  </div>
  <div class="container masthead">
    <a class="logo-link" href={`/${lang}/`} aria-label={c.home}>
      <Logo lang={lang} />
    </a>
    <div class="header-contact">
      <a class="header-phone" href={contact.tel}>
        <Icon name="phone" />
        {contact.phone}
      </a>
      <a class="header-email" href={`mailto:${contact.email}`}>
        <Icon name="mail" />
        {contact.email}
      </a>
    </div>
    <a class="button header-quote" href={enquiryPath(pageId, lang)}>
      {c.quote}
    </a>
  </div>
  <nav class="desktop-nav" aria-label={c.navLabel}>
    <ul class="container">
      <li>
        <a
          class:list={{ 'nav-home': true, 'nav-active': pageId === 'home' }}
          aria-current={pageId === 'home' ? 'page' : undefined}
          href={`/${lang}/`}
        >
          {lang === 'en' ? 'HOME' : 'ACCUEIL'}
        </a>
      </li>
      {c.nav.map((label, i) => (
        <li>
          <a
            href={pathFor(navIds[i], lang)}
            aria-current={pageId === navIds[i] ? 'page' : undefined}
            class:list={{
              'nav-active': pageId === navIds[i] || parent === navIds[i],
            }}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <details class="mobile-nav">
    <summary>
      <span>{c.menu}</span>
      <span class="menu-bars" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </summary>
    <nav aria-label={c.navLabel}>
      <ul>
        <li>
          <a
            class:list={{ 'nav-active': pageId === 'home' }}
            aria-current={pageId === 'home' ? 'page' : undefined}
            href={`/${lang}/`}
          >
            {lang === 'en' ? 'HOME' : 'ACCUEIL'}
          </a>
        </li>
        {c.nav.map((label, i) => (
          <li>
            <a
              href={pathFor(navIds[i], lang)}
              aria-current={pageId === navIds[i] ? 'page' : undefined}
              class:list={{
                'nav-active': pageId === navIds[i] || parent === navIds[i],
              }}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
