---
import Logo from './Logo.astro';
import { content, contact, type Locale } from '../data/content';
import { pathFor, labelFor, footerIds, type PageId } from '../data/routes';
import { credits } from '../data/credits';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = content[lang];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href={`/${lang}/`} aria-label={c.home}>
          <Logo lang={lang} dark />
        </a>
        <p>{c.footerText}</p>
      </div>
      <div>
        <h2>{c.footerServices}</h2>
        <ul>
          {c.cards.map((card) => (
            <li>
              <a
                href={pathFor(
                  (card.id === 'equipment'
                    ? 'defibrillators'
                    : card.id) as PageId,
                  lang,
                )}
              >
                {card.title}
              </a>
            </li>
          ))}
          <li>
            <a href={pathFor('programs', lang)}>{c.nav[4]}</a>
          </li>
        </ul>
      </div>
      <div>
        <h2>{c.footerContact}</h2>
        <a class="footer-phone" href={contact.tel}>
          {contact.phone}
        </a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <p>{c.footerLanguage}</p>
      </div>
    </div>
    <nav
      class="footer-info"
      aria-label={
        lang === 'en'
          ? 'Company and website information'
          : 'Information sur l’entreprise et le site'
      }
    >
      <ul>
        {footerIds.map((id) => (
          <li>
            <a href={pathFor(id, lang)}>{labelFor(id, lang)}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="emergency">{c.emergency}</p>
    <details class="photo-credits">
      <summary>{c.credits}</summary>
      <p>{c.creditsNote}</p>
      <p>
        {lang === 'en'
          ? 'Illustrations show example settings. Product photographs are credited below.'
          : 'Les illustrations présentent des exemples de situations. Les crédits des photos de produits figurent ci-dessous.'}
      </p>
      <ul>
        {credits.map((item) => (
          <li>
            <a href={item.url}>{item.label}</a> ·{' '}
            <a href={item.licenseUrl}>{item.license}</a>
          </li>
        ))}
      </ul>
    </details>
    <p class="small">
      {lang === 'en'
        ? 'Operated by Superclean Canada Inc.'
        : 'Exploité par Superclean Canada Inc.'}
    </p>
    <p class="copyright">
      © {new Date().getFullYear()} {c.copyright}
    </p>
  </div>
</footer>
