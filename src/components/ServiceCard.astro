---
import ApprovedScene from './ApprovedScene.astro';
interface Props {
  id: 'equipment' | 'accessories' | 'installation' | 'maintenance';
  href: string;
  image: string;
  title: string;
  text: string;
  link: string;
  alt: string;
}
const { id, image, title, text, link, alt, href } = Astro.props;
---

<article class="service-card" id={id}>
  <div class={`service-photo photo-${image}`}>
    <ApprovedScene scene={id} alt={alt} />
  </div>
  <div class="service-content">
    <h3>
      <a href={href} aria-label={`${title}: ${link}`}>
        {title}
        <span class="card-arrow" aria-hidden="true">
          ›
        </span>
      </a>
    </h3>
    <p>{text}</p>
  </div>
</article>
