---
import PageVisual from './PageVisual.astro';
import { pageVisuals } from '../data/visuals';
import type { Locale } from '../data/content';
interface Props {
  lang: Locale;
  id: 'equipment' | 'accessories' | 'installation' | 'maintenance';
  href: string;
  image: string;
  title: string;
  text: string;
  link: string;
  alt: string;
}
const { id, image, title, text, link, lang, href } = Astro.props;
---

<article class="service-card" id={id}>
  <div class={`service-photo photo-${image}`}>
    <PageVisual
      image={pageVisuals[id === 'equipment' ? 'defibrillators' : id]!}
      lang={lang}
      sizes="(max-width: 599px) 94vw, (max-width: 900px) 46vw, 23vw"
    />
  </div>
  <div class="service-content">
    <h3>
      <a href={href} aria-label={`${title}: ${link}`}>
        {title}
        <span class="card-arrow" aria-hidden="true">
          ›
        </span>
      </a>
    </h3>
    <p>{text}</p>
  </div>
</article>
