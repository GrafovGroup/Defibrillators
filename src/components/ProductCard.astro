---
import { pathFor, labelFor } from '../data/routes';
import { pageVisuals, visuals } from '../data/visuals';
import PageVisual from './PageVisual.astro';
import type { Locale } from '../data/content';
import type { ProductReference } from '../data/products';
interface Props {
  lang: Locale;
  product: ProductReference;
}
const { lang, product } = Astro.props;
const image = pageVisuals[product.id];
---

<article
  class="product-card"
  data-product
  data-environments={product.environments.join(',')}
  data-type={product.productType}
  data-guidance={product.guidanceMode}
  data-brand={product.manufacturer}
  data-search={`${product.manufacturer} ${product.model} ${product.guidance[lang]}`.toLocaleLowerCase(
    lang,
  )}
>
  {image ? (
    <div class="product-photo">
      <PageVisual
        image={image}
        lang={lang}
        sizes="(max-width: 767px) 94vw, (max-width: 1099px) 46vw, 31vw"
      />
      {visuals[image].kind === 'context' && (
        <span class="visual-label">
          {lang === 'en' ? 'Illustrative setting' : 'Contexte illustratif'}
        </span>
      )}
    </div>
  ) : (
    <div class="product-reference" aria-hidden="true">
      <span>{product.manufacturer}</span>
      <strong>{product.model}</strong>
      <span>{lang === 'en' ? 'Model reference' : 'Fiche de modèle'}</span>
    </div>
  )}
  <div class="product-copy">
    <p class="eyebrow">{product.manufacturer}</p>
    <h3>
      <a href={pathFor(product.id, lang)}>{labelFor(product.id, lang)}</a>
    </h3>
    <p>{product.guidance[lang]}</p>
    <span class="status-label">
      {lang === 'en'
        ? 'Reference model · availability unconfirmed'
        : 'Modèle de référence · disponibilité non confirmée'}
    </span>
    <a class="text-link" href={pathFor(product.id, lang)}>
      {lang === 'en'
        ? 'View model information'
        : 'Consulter la fiche du modèle'}
    </a>
  </div>
</article>
