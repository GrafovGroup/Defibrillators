---
import { contact, type Locale } from '../data/content';
import { enquiryPath } from '../lib/enquiry';
import type { PageId } from '../data/routes';
import { locationRoutes } from '../data/location-routes';
interface Props {
  lang: Locale;
  subject?: string;
  quote?: boolean;
  pageId?: PageId;
}
const { lang, subject, quote = false, pageId = 'contact' } = Astro.props;
const location = Object.hasOwn(locationRoutes, pageId);
const request = new URL(
  enquiryPath(pageId, lang),
  'https://defibrillators.ca',
).searchParams.get('request');
const service = [
  'installation',
  'maintenance',
  'programs',
  'training',
].includes(request ?? '');
---

<div class="enquiry-actions" id="contact">
  <h2>
    {lang === 'en'
      ? 'Let’s discuss your requirements'
      : 'Discutons de vos besoins'}
  </h2>
  <p>
    {lang === 'en'
      ? 'Send a request or contact us directly.'
      : 'Envoyez une demande ou joignez-nous directement.'}
  </p>
  {!quote && (
    <a class="button" href={enquiryPath(pageId, lang)}>
      {location
        ? lang === 'en'
          ? 'Discuss your project'
          : 'Discuter de votre projet'
        : service
          ? lang === 'en'
            ? 'Request a service'
            : 'Demander un service'
          : lang === 'en'
            ? 'Ask about this equipment'
            : 'Se renseigner sur cet équipement'}
    </a>
  )}
  <a
    class="text-link"
    href={`mailto:${contact.email}?subject=${encodeURIComponent(subject ?? (lang === 'en' ? 'AED enquiry' : 'Demande — DEA'))}`}
  >
    {lang === 'en' ? 'Email your enquiry' : 'Envoyer une demande par courriel'}
  </a>
  <p class="email-hint">
    {lang === 'en'
      ? 'The email link opens your email app.'
      : 'Le lien de courriel ouvre votre application de messagerie.'}
  </p>
  <a class="contact-phone" href={contact.tel}>
    {contact.phone}
  </a>
  <a class="plain-email" href={`mailto:${contact.email}`}>
    {contact.email}
  </a>
</div>
