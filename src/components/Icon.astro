---
interface Props {
  name:
    | 'truck'
    | 'tools'
    | 'clipboard'
    | 'training'
    | 'shield'
    | 'maple'
    | 'phone'
    | 'mail';
}
const paths = {
  truck:
    'M2 5h13v12H2z M15 10h4l3 4v3h-7 M7 17a2 2 0 1 0 0 .1 M18 17a2 2 0 1 0 0 .1',
  tools:
    'M14 4a5 5 0 0 0-6 6L2 18a2 2 0 0 0 4 3l7-8a5 5 0 0 0 7-6l-4 3-3-3 1-3 M3 3l5 5 M3 3l2 4 M14 15l6 6 2-2-6-6',
  clipboard: 'M8 5H4v17h16V5h-4 M9 2h6v5H9z M8 14l3 3 5-6',
  training: 'M1 8l11-5 11 5-11 5L1 8 M6 11v7q6 5 12 0v-7 M22 9v9',
  shield: 'M12 2l9 4v6q0 6-9 10Q3 18 3 12V6l9-4 M7 12l3 3 7-7',
  phone: 'M5 2l4 4-2 3q2 5 7 7l3-2 4 4-2 3C9 23 1 15 2 5l3-3z',
  mail: 'M2 4h20v16H2z M2 5l10 8L22 5',
};
---

<svg
  class={`icon icon-${Astro.props.name}`}
  width="28"
  height="28"
  viewBox={Astro.props.name === 'maple' ? '0 0 100 110' : '0 0 24 24'}
  fill={Astro.props.name === 'maple' ? 'currentColor' : 'none'}
  stroke={Astro.props.name === 'maple' ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {Astro.props.name === 'maple' ? (
    <use href="/brand/maple-leaf.svg#leaf" />
  ) : (
    <path d={paths[Astro.props.name]} />
  )}
</svg>
