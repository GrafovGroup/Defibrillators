---
import { pathFor, labelFor, type PageId } from '../data/routes';
import { pageFor } from '../data/pages';
import PageVisual from './PageVisual.astro';
import type { Locale } from '../data/content';
interface Props {
  lang: Locale;
  pageId: PageId;
  compact?: boolean;
}
const { lang, pageId, compact = false } = Astro.props;
const page = pageFor(pageId);
---

<article class="page-card">
  {page.image && (
    <PageVisual
      image={page.image}
      lang={lang}
      sizes="(max-width: 480px) 94vw, (max-width: 1024px) 46vw, 31vw"
    />
  )}
  <div>
    <h2>
      <a href={pathFor(pageId, lang)}>{labelFor(pageId, lang)}</a>
    </h2>
    {!compact && <p>{page.intro[lang]}</p>}
  </div>
</article>
