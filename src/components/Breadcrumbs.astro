---
import { pathFor, labelFor, type PageId } from '../data/routes';
import { pageFor } from '../data/pages';
import type { Locale } from '../data/content';
interface Props {
  lang: Locale;
  pageId: Exclude<PageId, 'home'>;
}
const { lang, pageId } = Astro.props;
const parent = pageFor(pageId).parent;
---

<nav
  class="breadcrumbs container"
  aria-label={lang === 'en' ? 'Breadcrumb' : 'Fil d’Ariane'}
>
  <ol>
    <li>
      <a href={pathFor('home', lang)}>{labelFor('home', lang)}</a>
    </li>
    {parent && (
      <li>
        <a href={pathFor(parent, lang)}>{labelFor(parent, lang)}</a>
      </li>
    )}
    <li>
      <span aria-current="page">{labelFor(pageId, lang)}</span>
    </li>
  </ol>
</nav>
