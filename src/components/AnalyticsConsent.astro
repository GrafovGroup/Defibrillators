---
import type { Locale } from '../data/content';
import { measurementId } from '../data/analytics';
import { pathFor } from '../data/routes';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = (en: string, fr: string) => (lang === 'en' ? en : fr);
---

<aside
  class="analytics-consent"
  data-analytics-consent
  data-measurement-id={measurementId}
  aria-labelledby="analytics-heading"
  hidden
>
  <div>
    <h2 id="analytics-heading" tabindex="-1">
      {t('Optional analytics', 'Statistiques facultatives')}
    </h2>
    <p>
      {t(
        'With your permission, Google Analytics uses cookies to help us understand page visits and enquiry activity. Your form answers are excluded. You can change your choice below at any time.',
        'Avec votre permission, Google Analytics utilise des témoins pour mesurer les visites et l’activité des demandes. Vos réponses aux formulaires sont exclues. Vous pouvez modifier votre choix au bas de la page à tout moment.',
      )}
    </p>
    <a href={pathFor('privacy', lang)}>
      {t('Privacy details', 'Détails de confidentialité')}
    </a>
  </div>
  <div class="analytics-actions">
    <button type="button" data-analytics-allow>
      {t('Allow analytics', 'Accepter les statistiques')}
    </button>
    <button type="button" data-analytics-deny>
      {t('No thanks', 'Non merci')}
    </button>
  </div>
</aside>
<style>
  .analytics-consent {
    position: fixed;
    inset: auto 1rem 1rem;
    z-index: 50;
    max-width: 72rem;
    margin: auto;
    padding: 1.25rem;
    background: #fff;
    color: var(--navy);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 4px 28px #102b4e33;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-height: 80vh;
    overflow: auto;
  }
  .analytics-consent[hidden] {
    display: none;
  }
  h2 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }
  p {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }
  a {
    font-size: 0.9rem;
    text-decoration: underline;
  }
  .analytics-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  button {
    font: inherit;
    font-weight: 700;
    padding: 0.75rem 1rem;
    min-height: 44px;
    border: 2px solid var(--navy);
    border-radius: 0.3rem;
    background: #fff;
    color: var(--navy);
    cursor: pointer;
  }
  button:hover {
    background: #eef2f7;
  }
  @media (max-width: 900px) {
    .analytics-consent {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    .analytics-actions > button {
      flex: 1;
    }
  }
</style>
<script>
  import '../scripts/analytics-consent';
</script>
