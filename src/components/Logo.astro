---
import { content, type Locale } from '../data/content';
interface Props {
  lang: Locale;
  dark?: boolean;
}
const { lang, dark = false } = Astro.props;
---

<span class="brand">
  <img
    src={`/brand/logo-${lang}-${dark ? 'dark' : 'light'}.svg`}
    width="492"
    height="88"
    alt={`Defibrillators.ca — ${content[lang].tagline}`}
  />
</span>
