---
import { content, type Locale } from '../data/content';
import { pathFor } from '../data/routes';
import Icon from './Icon.astro';
import ApprovedScene from './ApprovedScene.astro';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = content[lang];
const benefitIcons = [
  'truck',
  'tools',
  'clipboard',
  'training',
  'shield',
  'maple',
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 id="hero-title">{c.headline}</h1>
      <p class="hero-description">{c.heroText}</p>
      <div class="actions">
        <a class="button" href={pathFor('defibrillators', lang)}>
          {c.shop}
          <span aria-hidden="true">›</span>
        </a>
        <a class="button button-outline" href={pathFor('quote', lang)}>
          {c.quote}
        </a>
      </div>
    </div>
    <figure class="hero-image">
      <ApprovedScene scene="hero" alt={c.heroAlt} />
      <figcaption>{c.heroCaption}</figcaption>
    </figure>
  </div>
</section>
<div class="benefit-strip">
  <ul class="container">
    {c.benefits.map((benefit, i) => (
      <li>
        <Icon name={benefitIcons[i]} />
        <span>{benefit}</span>
      </li>
    ))}
  </ul>
</div>
