---
import { content, type Locale } from '../data/content';
import { pathFor, type PageId } from '../data/routes';
interface Props {
  lang: Locale;
  pageId?: PageId;
}
const { lang, pageId = 'home' } = Astro.props;
---

<nav class="locale-switch" aria-label={content[lang].language}>
  <a
    href={pathFor(pageId, 'en')}
    lang="en-CA"
    hreflang="en-CA"
    aria-label="English"
    aria-current={lang === 'en' ? 'page' : undefined}
  >
    EN
  </a>
  <span aria-hidden="true">/</span>
  <a
    href={pathFor(pageId, 'fr')}
    lang="fr-CA"
    hreflang="fr-CA"
    aria-label="Français"
    aria-current={lang === 'fr' ? 'page' : undefined}
  >
    FR
  </a>
</nav>
